---
const reasons = [
  "Her kindness makes every room warmer.",
  "She's brilliant, curious, and endlessly thoughtful.",
  "Her laugh is the best sound in the world.",
  "She makes hard days easier and good days better.",
  "She's generous with her time, her heart, and her ideas.",
  "She's beautiful, inside and out.",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Arsh Is Wonderful</title>
    <meta name="description" content="A website dedicated to Arsh, the most wonderful person I know." />
  </head>
  <body>
    <main class="praise">
      <p class="eyebrow">A website dedicated to</p>
      <h1>Arsh</h1>
      <p class="lede">The most wonderful person I know.</p>
      <ul>
        {reasons.map((reason) => <li>{reason}</li>)}
      </ul>
      <p class="signoff">Arsh, you are amazing. <span aria-hidden="true">♥</span></p>
    </main>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.6;
    color: #3a1f2b;
    background: #fff5f7;
  }
  body {
    min-height: 100vh;
    background: linear-gradient(160deg, #fff5f7 0%, #ffe3ea 100%);
  }
  .praise { max-width: 40rem; margin: 0 auto; padding: 4rem 1rem; text-align: center; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.85rem; color: #a0526d; }
  .praise h1 { font-size: clamp(3.5rem, 15vw, 6rem); line-height: 1.1; color: #c2185b; margin: 0.5rem 0; }
  .lede { font-size: 1.35rem; font-style: italic; margin-bottom: 2.5rem; }
  .praise ul { list-style: none; display: grid; gap: 1rem; text-align: left; }
  .praise li { background: #ffffffcc; border-radius: 0.75rem; padding: 1rem 1.25rem; box-shadow: 0 2px 8px #c2185b1a; }
  .praise li::before { content: "♥"; color: #c2185b; margin-right: 0.75rem; }
  .signoff { margin-top: 3rem; font-size: 1.25rem; color: #c2185b; }
</style>
