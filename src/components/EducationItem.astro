---
interface Props {
  name: string;
  url?: string;
  technologies: string;
  description: string;
}

const { name, url, technologies, description } = Astro.props;

// Simple markdown bold parser
function parseBold(text: string): string {
  return text.replace(/\*([^*]+)\*/g, '<strong class="text-gray-900 dark:text-neutral-100 print:text-gray-900 font-medium">$1</strong>');
}
---

<div class="break-inside-avoid">
  <div class="flex justify-between items-start mb-2">
    <div>
      <h4 class="text-gray-900 dark:text-neutral-100 print:text-gray-900">
        {url ? (
          <a href={url} class="hover:underline" target="_blank" rel="noopener noreferrer">
            {name}
          </a>
        ) : (
          name
        )}
      </h4>
      <p class="text-gray-400 dark:text-neutral-500 print:text-gray-400">{technologies}</p>
    </div>
  </div>
  <p class="text-gray-600 dark:text-neutral-300 print:text-gray-600" set:html={parseBold(description)} />
</div>
