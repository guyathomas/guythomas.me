---
interface Props {
  title: string;
  company: string;
  location?: string;
  date: string;
  achievements: string[];
}

const { title, company, location, date, achievements } = Astro.props;

// Simple markdown bold parser (*text* -> <strong>text</strong>)
function parseBold(text: string): string {
  return text.replace(/\*([^*]+)\*/g, '<strong class="text-gray-900 dark:text-neutral-100 print:text-gray-900 font-medium">$1</strong>');
}
---

<div class="break-inside-avoid group">
  <div class="flex flex-col sm:flex-row print:flex-row sm:justify-between print:justify-between sm:items-start print:items-start mb-3 print:mb-2">
    <div>
      <h4 class="text-gray-900 dark:text-neutral-100 print:text-gray-900">{title}</h4>
      <p class="text-gray-400 dark:text-neutral-500 print:text-gray-400">
        {company}
        {location && ` • ${location}`}
      </p>
    </div>
    <span class="text-gray-400 dark:text-neutral-500 print:text-gray-400 sm:whitespace-nowrap print:whitespace-nowrap sm:ml-4 print:ml-4 text-sm sm:text-base print:text-base">{date}</span>
  </div>
  <ul class="list-disc list-outside ml-5 space-y-2 print:space-y-1 text-gray-600 dark:text-neutral-300 print:text-gray-600 marker:text-gray-300 dark:marker:text-neutral-600 print:marker:text-gray-300">
    {achievements.map((achievement) => (
      <li set:html={parseBold(achievement)} />
    ))}
  </ul>
</div>
