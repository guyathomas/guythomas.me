---
interface Props {
  name: string;
  title: string;
  email: string;
  phone: string;
  location: string;
  website?: string;
}

const { name, title, email, phone, location, website } = Astro.props;
---

<header class="mb-8 relative">
  <div class="absolute -left-6 sm:-left-8 top-0 w-1 h-full sm:h-[200%] bg-gradient-to-b from-yellow-500 via-yellow-400 to-yellow-300/40 dark:from-yellow-400 dark:via-yellow-500 dark:to-yellow-600/40 print:opacity-70"></div>

  <h1 class="text-gray-900 dark:text-neutral-100 print:text-gray-900 mb-3 uppercase tracking-[0.2em] md:tracking-[0.25em] print:tracking-[0.25em] text-3xl md:text-4xl print:text-4xl leading-tight mt-0">{name}</h1>
  <h2 class="text-gray-500 dark:text-neutral-400 print:text-gray-500 mb-3 text-sm sm:text-base print:text-base uppercase tracking-[0.15em] sm:tracking-[0.2em] print:tracking-[0.2em]">{title}</h2>

  <div class="flex flex-wrap gap-x-4 gap-y-1 sm:gap-x-6 sm:gap-y-2 text-gray-500 dark:text-neutral-400 print:text-gray-500">
    <a href={`mailto:${email}`} class="hover:text-gray-900 dark:hover:text-neutral-200 print:text-gray-500 transition-colors">
      {email}
    </a>
    <span>{phone}</span>
    <span>{location}</span>
    {website && (
      <a href={`https://${website}`} class="hover:text-gray-900 dark:hover:text-neutral-200 print:text-gray-500 transition-colors">
        {website}
      </a>
    )}
  </div>
</header>
